# ============================================================================
# GeoSense AI: Environment Configuration
# ============================================================================

# Application Identity
APP_NAME="GeoSense AI"
VERSION="1.0.0"
PORT=8000
LOG_LEVEL="INFO"

# Hardware & Acceleration
# Options: "auto" (detects CUDA, falls back to CPU), "cpu", or "cuda"
DEVICE="auto"
# Number of CPU threads for PyTorch intra-op parallelism (set to physical core count)
TORCH_THREADS=16

# Model Management & Memory Limits
# Maximum heavy ML models held simultaneously in memory (LRU evicted beyond this)
MAX_LOADED_MODELS=2
# Maximum inference wall-clock timeout in seconds
INFERENCE_TIMEOUT_S=120
# Enable deterministic algorithmic/statistical fallback if model weights are unavailable
DEMO_MODE=true

# Storage & File Ingestion
DATA_DIR="data"
MAX_UPLOAD_SIZE_MB=50

# Security & Network
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:5173", "http://127.0.0.1:8000"]
